PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=<gere-um-segredo-forte-com-openssl-rand-hex-64>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# URLs separadas por vírgula. Em dev, as origens padrão são usadas automaticamente.
CORS_ORIGINS=https://we-cultural-frontend.vercel.app,https://we-cultural-backend.onrender.com
FRONTEND_URL=https://we-cultural-frontend.vercel.app

GMAIL_EMAIL=<seu-email@gmail.com>
GMAIL_PASSWORD=<app-password-do-gmail>
